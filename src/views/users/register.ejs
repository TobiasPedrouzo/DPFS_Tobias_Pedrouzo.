<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<main class="page-shell narrow auth-page"><p class="eyebrow">Bienvenido a Nido Sur</p><h1>Crear una cuenta</h1><p class="lead">Guardá tus favoritos y seguí tus pedidos.</p><% if (errors.length) { %><div class="errors"><% errors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %><form class="form-card" method="post" enctype="multipart/form-data" data-validate="register"><div class="form-row"><label>Nombre<input name="firstName" required minlength="2" value="<%= old.firstName || '' %>"></label><label>Apellido<input name="lastName" required minlength="2" value="<%= old.lastName || '' %>"></label></div><label>Email<input name="email" type="email" required value="<%= old.email || '' %>"></label><label>Contraseña<input name="password" type="password" minlength="8" required></label><label>Foto de perfil <input name="image" type="file" accept="image/png,image/jpeg,image/gif"></label><button class="button" type="submit">Crear cuenta</button></form><p class="form-note">¿Ya tenés cuenta? <a href="/users/login">Ingresá acá</a>.</p></main>
<%- include('../partials/footer') %>
