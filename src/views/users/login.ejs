<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<main class="page-shell narrow auth-page"><p class="eyebrow">Tu espacio</p><h1>Ingresar</h1><% if (errors.length) { %><div class="errors"><% errors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %><form class="form-card" method="post" data-validate="login"><label>Email<input name="email" type="email" required value="<%= old.email || '' %>"></label><label>Contraseña<input name="password" type="password" required></label><label class="checkbox"><input name="remember" type="checkbox"> Recordarme en este dispositivo</label><button class="button" type="submit">Ingresar</button></form><p class="form-note">¿Todavía no tenés cuenta? <a href="/users/register">Creala acá</a>.</p></main>
<%- include('../partials/footer') %>
