<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<main class="page-shell narrow"><a class="back-link" href="/products">← Volver</a><p class="eyebrow">Catálogo</p><h1><%= title %></h1><% if (errors.length) { %><div class="errors"><% errors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %><form class="form-card" method="post" action="<%= product.id ? '/products/' + product.id + '?_method=PUT' : '/products' %>" data-validate="product"><label>Nombre<input name="name" required minlength="5" value="<%= product.name || '' %>"></label><label>Descripción<textarea name="description" required minlength="20"><%= product.description || '' %></textarea></label><label>Imagen (URL)<input name="image" required type="url" value="<%= product.image || '' %>"></label><div class="form-row"><label>Categoría<input name="category" required value="<%= product.category?.name || product.category || '' %>"></label><label>Precio<input name="price" required type="number" min="0" step="0.01" value="<%= product.price || '' %>"></label></div><div class="form-row"><label>Colores<input name="colors" value="<%= (product.colors || []).join(', ') %>"></label><label>Tamaños<input name="sizes" value="<%= (product.sizes || []).join(', ') %>"></label></div><label>Stock<input name="stock" type="number" min="0" value="<%= product.stock || 0 %>"></label><button class="button" type="submit">Guardar producto</button></form></main>
<%- include('../partials/footer') %>
