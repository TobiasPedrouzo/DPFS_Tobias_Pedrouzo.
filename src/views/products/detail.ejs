<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<main class="page-shell"><a class="back-link" href="/products">← Volver a la colección</a><section class="detail-grid"><div class="detail-image"><img src="<%= product.image %>" alt="<%= product.name %>"></div><div class="detail-copy"><p class="eyebrow"><%= product.category?.name %></p><h1><%= product.name %></h1><p class="detail-price">$ <%= Number(product.price).toLocaleString('es-AR') %></p><p class="lead"><%= product.description %></p><div class="detail-specs"><div><span>Colores</span><strong><%= (product.colors || []).join(' · ') %></strong></div><div><span>Medidas</span><strong><%= (product.sizes || []).join(' · ') %></strong></div></div><button class="button add-to-cart" data-product-id="<%= product.id %>">Sumar al carrito <span>+</span></button><div class="admin-actions"><a href="/products/<%= product.id %>/edit">Editar</a><form method="post" action="/products/<%= product.id %>?_method=DELETE"><button type="submit">Eliminar</button></form></div></div></section></main>
<%- include('../partials/footer') %>
